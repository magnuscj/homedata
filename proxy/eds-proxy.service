# systemd unit: runs the eds edge reverse proxy as a pinned nginx container.
# Replaces the old port_forward.sh while-loop with a supervised, restart-on-
# failure service that also recovers the real client IP (see nginx-eds.conf).
#
# Install: see proxy/install.sh (copies config, enables + starts this unit).
# Logs land in /home/magnus/eds-logs on the host (rotated by logrotate-eds).

[Unit]
Description=eds edge reverse proxy (nginx) - real client IP logging
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
# Pinned image tag for reproducibility; bump deliberately.
Environment=NGINX_IMAGE=nginx:1.27-alpine
Environment=CONF=/etc/eds-proxy/nginx-eds.conf
Environment=LOGDIR=/home/magnus/eds-logs

# Clean up any stale container from a previous run before starting.
ExecStartPre=-/usr/bin/docker rm -f eds-proxy
ExecStart=/usr/bin/docker run --rm --name eds-proxy \
  --network host \
  -v ${CONF}:/etc/nginx/conf.d/default.conf:ro \
  -v ${LOGDIR}:/var/log/nginx \
  --log-opt max-size=10m --log-opt max-file=3 \
  ${NGINX_IMAGE}
ExecStop=/usr/bin/docker stop eds-proxy

Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
